{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/myfirstproject/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)$",
      "destination": "/api/server"
    }
  ],
  "functions": {
    "api/server.mjs": {
      "includeFiles": "dist/myfirstproject/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

