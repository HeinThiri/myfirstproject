{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/myfirstproject/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server"
    }
  ],
  "functions": {
    "api/server.mjs": {
      "runtime": "nodejs20.x",
      "includeFiles": "dist/myfirstproject/**"
    }
  }
}

